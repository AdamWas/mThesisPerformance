FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /usr/app

# Minimal deps (Debian-based dotnet/runtime)
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates wget libcap2-bin && \
    rm -rf /var/lib/apt/lists/*

COPY . .
RUN chmod +x ./gg

EXPOSE 81 5004

CMD ["./gg", "./Performance.Graftcode.Server.dll", "--port", "81", "--httpPort", "5004"]
